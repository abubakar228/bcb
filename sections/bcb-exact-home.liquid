{% liquid
  assign service_url = pages['table-service'].url | default: '/pages/table-service'
  assign contact_url = pages['contact'].url | default: '/pages/contact'
  assign about_url = pages['about'].url | default: '/pages/about'
  assign featured_handles = 'pro-series-square-pool-chalk-holder,pro-series-circle-pool-chalk-holder,metal-pool-chalk-holder,aluminum-chalk-holder,ultra-grip-magnetic-chalk-holder,magnetic-chalk-holder-with-lid-belt-clip,aluminum-coin-holders-quarter-dispensers,coin-holder-with-transparent-slot' | split: ','
  assign taom_handles = 'taom-v10-blue-chalk,taom-maxracks,handmade-taom-billiard-cue-chalk,taom-midas-cue-glove' | split: ','
  assign bundle_1 = all_products['taom-v10-blue-chalk']
  assign bundle_2 = all_products['ultra-grip-magnetic-chalk-holder']
  assign bundle_3 = all_products['original-billiard-glove']
%}
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="badge">Grand Rapids, Michigan • Est. Premium Quality</span>
      <h1>Premium <em>Billiards Accessories</em> Built For Serious Players</h1>
      <p>At <strong>Beer City Billiards</strong>, we specialize in high-quality billiards accessories and professional pool table repair services across Michigan. Affordable, reliable, premium — for players of all levels.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Shop Best Sellers →</a>
        <a class="btn btn-outline" href="{{ service_url }}">Book Table Service</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><strong>2,500+</strong><span>Happy Players</span></div>
        <div class="stat"><strong>4.9★</strong><span>Customer Rating</span></div>
        <div class="stat"><strong>100%</strong><span>Satisfaction</span></div>
      </div>
    </div>
    <div class="hero-media"><img src="{{ 'bcb-src-hero.webp' | asset_url }}" alt="Beer City Billiards accessories on a pool table" fetchpriority="high" decoding="async"></div>
  </div>
</section>

<div class="trust"><div class="container trust-inner">
  <div class="trust-item"><i>✓</i> Free Shipping Over $50</div>
  <div class="trust-item"><i>✓</i> Premium Aluminum &amp; Steel Build</div>
  <div class="trust-item"><i>✓</i> Michigan Repair • 30min Travel Free</div>
  <div class="trust-item"><i>✓</i> Secure Checkout • Satisfaction Guaranteed</div>
</div></div>

<section class="section"><div class="container">
  <div class="section-head"><h2>Shop By Brand</h2><p>Curated brands trusted by league and tournament players across USA. Built for durability and performance.</p></div>
  <div class="brands-grid">
    <a class="brand-card" href="{{ routes.all_products_collection_url }}?filter.p.vendor=Beer+City+Billiards"><img src="{{ 'bcb-src-logo-768x599.png' | asset_url }}" alt="BEER CITY BILLIARDS" loading="lazy" decoding="async"><h3>BEER CITY BILLIARDS</h3><p>Holds $10 in quarters or dollar coins, then dispenses them one at a time with a press.</p><span class="textlink">Shop Now</span></a>
    <a class="brand-card" href="{{ routes.all_products_collection_url }}?filter.p.vendor=CRU5H"><img src="{{ 'bcb-src-logo-cru5h.webp' | asset_url }}" alt="CRU5H" loading="lazy" decoding="async"><h3>CRU5H</h3><p>Performance-driven hardware built around a rare-earth N48 magnet, engineered with low-profile geometry so you use chalk to the last millimetre.</p><span class="textlink">Shop Now</span></a>
    <a class="brand-card" href="{{ routes.all_products_collection_url }}?filter.p.vendor=Taom"><img src="{{ 'bcb-src-logo-taom.webp' | asset_url }}" alt="TAOM" loading="lazy" decoding="async"><h3>TAOM</h3><p>Experience the next level of precision with Taom V10 Professional Chalk.</p><span class="textlink">Shop Now</span></a>
    <a class="brand-card" href="{{ routes.all_products_collection_url }}?filter.p.vendor=Coinfinity"><img src="{{ 'bcb-src-logo-coinfinity.png' | asset_url }}" alt="COINIFINITY" loading="lazy" decoding="async"><h3>COINIFINITY</h3><p>Smart coin storage with NFC built in — twist-lock stackers that keep Silver Eagles, quarters and assay cards protected, organised and scannable.</p><span class="textlink">Shop Now</span></a>
  </div>
</div></section>

<section class="section" style="padding-top:0"><div class="container"><div class="split">
  <div class="split-content"><span class="badge" style="background:var(--gold)">Bestseller • Coin Holder</span><h2>Holds $10 In Quarters Securely. Jingle-Free.</h2><p>Designed for pool halls, arcades, vending machines, laundromats. The original aluminum dispenser players love.</p>
    <ul class="feat-list">
      <li><span>1</span><div><strong>Holds $10 in Quarters or Dollar Coins</strong>40 US or Canadian quarters, or a full roll of dollar coins</div></li>
      <li><span>2</span><div><strong>Spring-loaded for easy one-at-a-time dispensing</strong></div></li>
      <li><span>3</span><div><strong>Compact &amp; portable — fits a pocket, cue case or bag without bulk</strong></div></li>
      <li><span>4</span><div><strong>Durable metal build made for long-term use</strong></div></li>
    </ul>
    <a class="btn btn-primary" href="{{ collections['coin-holders'].url | default: routes.all_products_collection_url }}">View Coin Holders — From $10.29</a>
  </div>
  <div class="split-media"><img src="{{ 'bcb-src-coin-feature.webp' | asset_url }}" alt="Beer City Billiards coin holders in assorted colours" loading="lazy" decoding="async"></div>
</div></div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><span class="badge">Beer City Billiards</span><h2 style="margin-top:12px">Featured Accessories</h2></div><a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">View All Products</a></div>
  <div class="product-grid">{% for handle in featured_handles %}{% assign product = all_products[handle] %}{% if product != blank %}{% render 'bcb-exact-product-card', product: product %}{% endif %}{% endfor %}</div>
  {% if bundle_1 != blank and bundle_2 != blank and bundle_3 != blank %}
    {% assign bundle_total = bundle_1.price | plus: bundle_2.price | plus: bundle_3.price %}
    {% assign bundle_sale = bundle_total | times: 0.9 %}
    <div class="promo-strip">
      <div class="promo-thumbs">{{ bundle_1.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: bundle_1.title }}{{ bundle_2.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: bundle_2.title }}{{ bundle_3.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: bundle_3.title }}</div>
      <div><h3>The Sunday League Kit — Bundle &amp; save 10%</h3><p>Everything you need for league night in one click: tournament chalk, a magnetic holder that lives on your belt, and a glove that keeps your bridge hand honest.</p></div>
      <div style="display:grid;gap:10px;justify-items:end"><div class="promo-price">{{ bundle_sale | money }}<s>{{ bundle_total | money }}</s></div><button class="btn btn-primary bcb-bundle-button" type="button" data-add-bundle="{{ bundle_1.selected_or_first_available_variant.id }},{{ bundle_2.selected_or_first_available_variant.id }},{{ bundle_3.selected_or_first_available_variant.id }}">Add all three — save {{ bundle_total | minus: bundle_sale | money }}</button></div>
    </div>
  {% endif %}
</div></section>

<section class="section section--dark"><div class="container">
  <div class="section-head"><div><span class="badge">TAOM • Finland</span><h2 style="margin-top:12px">Shop TAOM Billiards Accessories</h2></div><p>Explore our collection of TAOM accessories, including the V10 and Pyro chalks, premium tips, and more. Tournament-grade reliability.</p></div>
  <div class="product-grid">{% for handle in taom_handles %}{% assign product = all_products[handle] %}{% if product != blank %}{% render 'bcb-exact-product-card', product: product %}{% endif %}{% endfor %}</div>
  <div class="promo-strip"><img src="{{ 'bcb-src-taom-promo.webp' | asset_url }}" alt="Taom V10 chalk" loading="lazy" style="width:80px;height:80px;object-fit:contain;background:#fff;border-radius:12px;padding:8px"><div><h3>TAOM V10 - Next Level Precision</h3><p>Designed with world's top pros. Exceptional grip, cleaner hands, stronger consistency.</p></div><a class="btn btn-primary" href="{{ all_products['taom-v10-blue-chalk'].url | default: routes.all_products_collection_url }}">Shop TAOM V10</a></div>
</div></section>

<section class="section"><div class="container"><div class="service-banner">
  <div class="service-content"><span class="badge">Michigan • Grand Rapids Area</span><h2>Professional Pool Table Repair Services</h2><p style="color:var(--muted);font-size:15px">A high-quality game starts with a perfectly maintained table. We offer residential, commercial, and tournament-grade service.</p>
    <ul class="service-list"><li>Re-Felting / Cloth Replacement</li><li>Table Leveling &amp; Slate Adjustment</li><li>Cushion &amp; Rail Rubber Replacement</li><li>Assembly &amp; Disassembly</li><li>Pool Table Moving</li><li>Restoration &amp; Refurbishing</li><li>Cue Stick Repairs</li></ul>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-dark" href="{{ contact_url }}">Get Quote for Repair</a><a class="btn btn-outline" href="{{ service_url }}">View Service Details</a></div>
    <p class="service-note">✓ All brands: Valley, Brunswick, Diamond, Olhausen • Travel within 30min of Grand Rapids FREE</p>
  </div>
  <div class="service-media"><img src="{{ 'bcb-src-table-service.webp' | asset_url }}" alt="Pool table repair service in Michigan" loading="lazy" decoding="async"></div>
</div></div></section>

<section class="section section--gray"><div class="container">
  <div class="section-head"><div><h2>Questions, Answered</h2></div><p>Shipping, fitment, returns and service — before you buy.</p></div>
  <div class="faq-grid"><div><p class="lede" style="margin-bottom:16px">Everything about shipping, fit, returns and service — answered by the people who pack the boxes.</p><a class="textlink" href="{{ contact_url }}">Still stuck? Contact us</a></div>
    <div class="faq">
      <div class="faq-item is-open"><button class="faq-q" type="button" data-faq aria-expanded="true">How fast does my order ship?<i></i></button><div class="faq-a"><p>Orders leave our Grand Rapids workshop within 1–3 business days. Standard U.S. shipping is free over $50, and every parcel is tracked.</p></div></div>
      <div class="faq-item"><button class="faq-q" type="button" data-faq aria-expanded="false">Will this chalk holder fit my chalk?<i></i></button><div class="faq-a"><p>Most holders are shaped for a specific chalk: round cups for Taom V10/Pyro, octagonal cups for Predator 1080, square and hexagon cups for standard cubes. Each product page lists what it fits — and our magnetic holders are universal.</p></div></div>
      <div class="faq-item"><button class="faq-q" type="button" data-faq aria-expanded="false">What's your return policy?<i></i></button><div class="faq-a"><p>Send anything back within 30 days, unused and in its original packaging, for a refund or exchange. Custom printed cue balls can't be returned unless faulty.</p></div></div>
      <div class="faq-item"><button class="faq-q" type="button" data-faq aria-expanded="false">Do you repair tables outside Grand Rapids?<i></i></button><div class="faq-a"><p>Yes — we cover West Michigan. Travel within 30 minutes of Grand Rapids is included; beyond that a small travel fee applies and we'll quote it up front.</p></div></div>
      <div class="faq-item"><button class="faq-q" type="button" data-faq aria-expanded="false">Do you offer wholesale?<i></i></button><div class="faq-a"><p>We do — up to 40% off retail with a $200 minimum order, low minimums per SKU and 1–3 business day lead times. Apply through the wholesale page.</p></div></div>
      <div class="faq-item"><button class="faq-q" type="button" data-faq aria-expanded="false">Can I get a custom or bulk order?<i></i></button><div class="faq-a"><p>Custom printing and bulk runs are available on selected items. Email beercitybilliards@gmail.com with what you need and we'll quote it.</p></div></div>
    </div>
  </div>
</div></section>

<section class="section"><div class="container"><div class="about-grid">
  <div class="about-img"><img src="{{ 'bcb-src-logo-1024x798.png' | asset_url }}" alt="Beer City Billiards logo" loading="lazy"></div>
  <div><span class="badge">About Beer City Billiards</span><h2 style="font-size:clamp(26px,3vw,36px);margin:12px 0 14px;line-height:.95">Passion For The Game Meets Precision Craftsmanship</h2>
    <p style="color:var(--muted);margin-bottom:14px">Welcome to Beer City Billiards, where passion for the game meets precision craftsmanship. Based on a commitment to quality and innovation, we specialize in providing premium snooker and billiards accessories to elevate your playing experience.</p>
    <p style="color:var(--muted);margin-bottom:20px">From finely crafted snooker chalk and magnetic chalk belt clips to versatile cue tip shapers and durable coin holders, every product we offer is designed with players in mind. Whether you're a seasoned professional or a passionate hobbyist, our range ensures you have the tools you need to play at your best.</p>
    <p style="font-weight:700;font-size:15px">Our mission is simple: deliver affordable, reliable, and premium pool products to players of all levels.</p>
    <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-dark" href="{{ about_url }}">Read Our Story</a><a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">Shop All Accessories</a></div>
  </div>
</div></div></section>

