{% liquid
  assign all_url = routes.all_products_collection_url
  assign chalk_holders_url = collections['chalk-holders'].url | default: all_url
  assign magnetic_url = collections['magnetic-chalk-holders'].url | default: all_url
  assign coin_url = collections['coin-holders'].url | default: all_url
  assign chalk_url = collections['chalks'].url | default: all_url
  assign rests_url = collections['cue-rests'].url | default: all_url
  assign gloves_url = collections['cue-gloves'].url | default: all_url
  assign tips_url = collections['cue-tips'].url | default: all_url
  assign gifts_url = collections['gift-sets'].url | default: all_url
  assign racks_url = collections['maxracks'].url | default: all_url
  assign service_url = pages['table-service'].url | default: '/pages/table-service'
  assign wholesale_url = pages['wholesale'].url | default: '/pages/wholesale'
  assign about_url = pages['about'].url | default: '/pages/about'
%}
<div class="announce">✦ FREE SHIPPING OVER $50 IN USA | <span>MICHIGAN'S TRUSTED POOL TABLE REPAIR</span> | 1–3 DAY DISPATCH</div>

<header class="header">
  <div class="container header-inner">
    <button class="icon-btn mobile-toggle" type="button" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">☰</button>
    <a class="logo" href="{{ routes.root_url }}">
      <img src="{{ 'bcb-src-logo-768x599.png' | asset_url }}" alt="Beer City Billiards" width="768" height="599">
      <span class="logo__text">Beer City Billiards<small>Grand Rapids, MI</small></span>
    </a>
    <nav class="nav">
      <a href="{{ all_url }}">Shop All</a>
      <a href="{{ chalk_holders_url }}">Chalk Holders</a>
      <a href="{{ coin_url }}">Coin Holders</a>
      <a href="{{ chalk_url }}">Taom Chalk</a>
      <a href="{{ service_url }}">Table Service</a>
      <a href="{{ wholesale_url }}">Wholesale</a>
      <a href="{{ about_url }}">About</a>
    </nav>
    <div class="header-actions">
      <button class="searchbox" type="button" data-search-open>
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Search accessories…</span>
        <kbd>/</kbd>
      </button>
      <a class="icon-btn icon-btn--phone" href="tel:+16166438058">
        <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg>
        616-643-8058
      </a>
      <button class="icon-btn" type="button" data-search-open aria-label="Search products">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="icon-btn" type="button" data-cart-open aria-label="Open cart" style="position:relative">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l1.5 12H4.5L6 7Z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/></svg>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
  <nav class="navbar" aria-label="Shop categories">
    <div class="container navbar__inner">
      <a href="{{ all_url }}">All Products</a>
      <a href="{{ chalk_holders_url }}">Chalk Holders</a>
      <a href="{{ magnetic_url }}">Magnetic Holders</a>
      <a href="{{ coin_url }}">Coin Holders</a>
      <a href="{{ chalk_url }}">Chalk</a>
      <a href="{{ rests_url }}">Cue Rests</a>
      <a href="{{ gloves_url }}">Cue Gloves</a>
      <a href="{{ tips_url }}">Tips &amp; Tools</a>
      <a href="{{ gifts_url }}">Gift Sets</a>
      <a href="{{ racks_url }}">MaxRacks</a>
      <a href="{{ service_url }}">Table Service</a>
      <a href="{{ wholesale_url }}">Wholesale</a>
    </div>
  </nav>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
  <a href="{{ all_url }}">Shop All</a>
  <a href="{{ chalk_holders_url }}">Chalk Holders</a>
  <a href="{{ magnetic_url }}">Magnetic Holders</a>
  <a href="{{ coin_url }}">Coin Holders</a>
  <a href="{{ chalk_url }}">Chalk</a>
  <a href="{{ rests_url }}">Cue Rests</a>
  <a href="{{ gloves_url }}">Cue Gloves</a>
  <a href="{{ gifts_url }}">Gift Sets</a>
  <a href="{{ service_url }}">Table Service</a>
  <a href="{{ wholesale_url }}">Wholesale</a>
  <a href="{{ about_url }}">About</a>
  <a href="/pages/contact">Contact</a>
</nav>

<div class="drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart">
  <div class="drawer__scrim" data-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <h3>Your cart</h3>
      <button class="drawer__close" type="button" data-close aria-label="Close cart"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg></button>
    </div>
    <div class="drawer__body" id="drawer-body"></div>
    <div class="drawer__foot" id="drawer-foot"></div>
  </div>
</div>

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Search products">
  <div class="search-overlay__inner">
    <div class="search-field">
      <input type="search" id="search-input" placeholder="Search products…" aria-label="Search products">
      <button class="btn btn-outline btn-sm" type="button" data-close>Close</button>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

{% schema %}
{"name":"BCB Exact Header","enabled_on":{"groups":["header"]},"settings":[]}
{% endschema %}