<div class="bcb-zip">
  <div class="announce">✦ FREE SHIPPING OVER $50 IN USA | <span>MICHIGAN'S TRUSTED POOL TABLE REPAIR</span> | SAME-DAY DISPATCH</div>
  <header class="header">
    <div class="container header-inner">
      <a href="{{ routes.root_url }}"><img src="{{ 'bcbzip-logo.png' | asset_url }}" alt="Beer City Billiards" class="logo"></a>
      <nav class="nav">
        <a href="{{ routes.all_products_collection_url }}">Shop All</a>
        <a href="{{ routes.all_products_collection_url }}">Brands ▾</a>
        <a href="{{ pages['table-service'].url | default: '/pages/table-service' }}">Table Service</a>
        <a href="{{ pages['about-us'].url | default: '/pages/about-us' }}">About</a>
        <a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a>
      </nav>
      <div class="header-actions">
        <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search" title="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account" title="Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart" title="Cart" style="position:relative">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count">{{ cart.item_count }}</span>
        </a>
        <button class="icon-btn mobile-toggle" type="button" aria-label="Menu" aria-expanded="false" data-bcb-mobile-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>
  <nav class="bcb-mobile-nav" data-bcb-mobile-nav aria-label="Mobile menu">
    <a href="{{ routes.all_products_collection_url }}">Shop All</a>
    <a href="{{ routes.all_products_collection_url }}">Brands</a>
    <a href="{{ pages['table-service'].url | default: '/pages/table-service' }}">Table Service</a>
    <a href="{{ pages['about-us'].url | default: '/pages/about-us' }}">About</a>
    <a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a>
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
  </nav>
</div>
{% schema %}{"name":"BCB ZIP Exact Header","enabled_on":{"groups":["header"]},"settings":[]}{% endschema %}