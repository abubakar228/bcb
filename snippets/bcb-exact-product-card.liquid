{% liquid
  assign short_title = product.title
  assign badge_text = ''
  case product.handle
    when 'pro-series-square-pool-chalk-holder'
      assign short_title = 'Pro Series Square Chalk Holder'
      assign badge_text = 'Best Seller'
    when 'pro-series-circle-pool-chalk-holder'
      assign short_title = 'Pro Series Circle Chalk Holder'
      assign badge_text = 'Best Seller'
    when 'metal-pool-chalk-holder'
      assign short_title = 'Metal Pool Chalk Holder'
    when 'aluminum-chalk-holder'
      assign short_title = 'Aluminium Circle Chalk Holder'
      assign badge_text = 'New'
    when 'ultra-grip-magnetic-chalk-holder'
      assign short_title = 'Ultra Grip Magnetic Chalk Holder'
      assign badge_text = 'Best Seller'
    when 'magnetic-chalk-holder-with-lid-belt-clip'
      assign short_title = 'Magnetic Chalk Holder with Lid'
      assign badge_text = 'New'
    when 'aluminum-coin-holders-quarter-dispensers'
      assign short_title = 'Aluminium Quarter Dispenser'
      assign badge_text = 'Best Seller'
    when 'coin-holder-with-transparent-slot'
      assign short_title = 'Coin Holder with Transparent Slot'
    when 'taom-v10-blue-chalk'
      assign short_title = 'Taom V10 Blue Chalk'
      assign badge_text = 'Best Seller'
    when 'taom-maxracks'
      assign short_title = 'Taom MaxRacks (3-Pack)'
      assign badge_text = 'Best Seller'
    when 'handmade-taom-billiard-cue-chalk'
      assign short_title = 'Handmade Taom Cue Chalk'
    when 'taom-midas-cue-glove'
      assign short_title = 'Taom Midas Cue Glove'
    when 'original-billiard-glove'
      assign short_title = 'Original Billiard Glove'
      assign badge_text = 'Best Seller'
  endcase
  assign variant = product.selected_or_first_available_variant
  assign low_stock = false
  if variant.inventory_management != blank and variant.inventory_quantity > 0 and variant.inventory_quantity <= 10
    assign low_stock = true
  endif
%}
<article class="prod-card" data-handle="{{ product.handle }}">
  <div class="prod-img">
    {% if product.available == false %}
      <span class="prod-badge prod-badge--red">Sold out</span>
    {% elsif low_stock %}
      <span class="prod-badge prod-badge--red">Only {{ variant.inventory_quantity }} left</span>
    {% elsif badge_text != blank %}
      <span class="prod-badge{% if badge_text == 'Best Seller' %} prod-badge--gold{% else %} prod-badge--green{% endif %}">{{ badge_text }}</span>
    {% endif %}
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260,360,520,700,900', alt: product.title }}
      {% endif %}
    </a>
  </div>
  <div class="prod-info">
    <span class="prod-vendor">{{ product.vendor }}</span>
    <h3><a href="{{ product.url }}">{{ short_title }}</a></h3>
    <div class="prod-price">{% if product.price_varies %}<span style="font-weight:600;color:var(--muted);font-size:13px">from</span> {% endif %}{{ product.price_min | money }}{% if product.price_varies %} – {{ product.price_max | money }}{% endif %}</div>
    {% if low_stock %}<span class="prod-stock">Only {{ variant.inventory_quantity }} left</span>{% endif %}
    <div class="prod-action">
      {% if product.available == false %}
        <button class="btn btn-outline btn-block" disabled>Sold out</button>
      {% elsif product.variants.size > 1 %}
        <a class="btn btn-outline btn-block" href="{{ product.url }}">Choose Options</a>
      {% else %}
        <form class="bcb-shopify-add" action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="btn btn-dark btn-block" type="submit">Add to Cart</button>
        </form>
      {% endif %}
    </div>
  </div>
</article>